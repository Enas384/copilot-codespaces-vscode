def U_RP(x, n, alpha):
    U0 = A0 / x**alpha
    if n == 0:
        return U0
    elif n == 1:
        return -alpha * (U0 / x)
    else:
        raise ValueError("Unsupported n value")
def U_SUGRA(x, n):
    U0 = (A1 / x**alpha1) * np.exp((1/2)*x**2)
    if n == 0:
        return U0 
    elif n == 1:
        return   U0*(x -(alpha1/x) )                 #-alpha1 * (U0 / x) + (x * U0)
    elif n == 2:
        return -alpha1 * (alpha1 + 1) * (U0 / x**2) - alpha1 * U0 + (1 - alpha1) * U0 + x**2 * U0
    else:
        raise ValueError("U(x) expected 'n' to be 0, 1, or 2")

def U_DExp(x, n):
