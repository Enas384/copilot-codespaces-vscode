def U(x, n, model, alpha):
    if model == "LCDM":
        return 0
    elif model == "RP":
        return U_RP(x, n, alpha)
    elif model == "SUGRA":
        return U_SUGRA(x, n)
    elif model == "DExp":
        return U_DExp(x, n)
    else:
        raise ValueError("U(x) expected 'n' to be 0, 1, or 2")

def w_q(a, x, y, model, alpha):
    return (y**2 - 2 * a**2 * U(x, 0, Model, alpha)) / (y**2 + 2 * a**2 * U(x, 0, Model, alpha))
def dphi (a,h,x,y,Omega_m,Omega_x,phi,Ux,Um,alpha,model):
    w_x = w_q(a, x, y, Model,alpha)
    dphida = -(phi / a) - (3 /2) * h * (Omega_m * Um + Omega_x * (1 + w_x) * Ux)
    return dphida

def dpsidt (a,h,x,y,Omega_m,Omega_x,phi,Ux,Um):
    return a*h*dphi(a, h, x, y, Omega_m, Omega_x, phi, Ux, Um)


def u_total(a,h,x,y,Omega_m,Omega_x,Um,Ux,alpha,model):
    w_x = w_q(a, x, y, Model, alpha)
    u = ((Omega_m*Um+Omega_x*Ux)/(1+ Omega_x*w_x))
    return u


def Q_x(a, h, x, y, Omega_m, Omega_x,Ux,Um,Dx,phi,k,etha,alpha, n,model):
    wx = w_q(a, x, y, Model,alpha)
    Qx = etha * h*(1 + wx)
    l = (k * c) / H0

    #(ux,um==0,use_u==False)
    if n == 0:
        return Qx
    elif n == 1:
        wx = w_q(a, x, y, Model, alpha)
        duxda = -(Ux / a) - (1/ (1 + wx)) * (Dx / (a**2 * h)) - (phi / (a**2 * h))
        u = u_total(Omega_m, Omega_x, a, Um, Ux, x, y,Model)
        dy_da = -2* ( y)/a - U(x, 1, Model,alpha)/h + Qx*Omega_x*((3*a*h)/y)
        ena = (-a**2*h*Ux*(dy_da/y)) - a**2*h*duxda
        dphida = dphi(a, h, x, y, Omega_m, Omega_x, phi, Ux, Um, alpha, model)
        
        return Qx* (ena - phi - a * dphida - ((l**2 *u) / (3 * a * h)))
    else:
        raise ValueError("Invalid value for n in Q_x")

        
def w_xeff(a,h,x,y,etha,n,model,alpha):
    wx = w_q(a, x, y, Model,alpha)  # Get the actual equation of state
    
    if n == 0:
        return wx
    elif n == 1:
        Qx  = etha * h*(1 +wx)
        return wx - (Qx / (3 * h))
    else:
        raise ValueError("Invalid value for n in w_xeff")
    
def w_meff(a,h,x,y,Omega_m, Omega_x,etha,alpha,n,model):
    wx = w_q(a, x, y, Model,alpha)
    wm =0
    if n==0:
        return wm
    elif n==1:
        Qx  = etha * h*(1 + wx)
        Qm = -(Omega_x/Omega_m)*Qx
        return wm - Qm/3/h
    
def dQxda(a, h,x,y,Omega_x,Omega_m,etha,alpha,model):
    wx =w_q(a, x, y, Model,alpha)
    wm = 0
    w = wx *Omega_x + wm *Omega_m
    Qx = etha * h*(1 + wx)
    weff = w_xeff(a, h, x, y, etha, 1, Model)
    dy_da = -2* ( y)/a - U(x, 1, Model,alpha)/h + Qx*Omega_x*((3*a*h)/y) 
    return (-3/2) * a * h**2 * (2*weff + 6 + wx * Omega_x)


def background(a,z,k):
    h, Omega_m, Omega_x = z
    w_x = -1
    w = Omega_m*w_m + Omega_x*w_x
    dh_da = -(3/2) * (h/a) * (1+w)
    dOmega_m_da = -(3/a) * (w_m - w) * Omega_m
    dOmega_x_da = -(3/a) * (w_x-w) * Omega_x
    #dOmega_x_da = -dOmega_m_da
    return np.array([dh_da, dOmega_m_da, dOmega_x_da])

def ODEs( k, etha, alpha, model):
        
    def LCDM(a,z):
        h, Omega_m, Omega_x,phi,Dm,Um = z
        l = ( k*c) / H0
        w_x = -1
        w = Omega_m*w_m + Omega_x*w_x
        dh_da = -(3/2) * (h/a) * (1+w)
        dOmega_m_da = -(3/a) * (w_m-w) * Omega_m
        dOmega_x_da = -(3/a) * (w_x-w) * Omega_x
        #dOmega_x_da = -dOmega_m_da
        dUmda = -(Um / a) - (phi/(a**2 * h))                        # u_m = H0*Vm
        dDmda = (9 / 2) * h * Omega_x * (1 + w_x) * (Um) + ((l**2 * Um) / (a**2 * h))
        dphida = -(phi / a) - (3 /2) * h * (Omega_m * Um )
        
        return np.array([dh_da, dOmega_m_da, dOmega_x_da,dphida,dDmda,dUmda])
    
    
    # Combined ODEs for background and perturbations
    def QCDM(a,z):
        h, Omega_m, Omega_x, y, x,phi,Dm,Um,Dx,Ux = z

        w_x = w_q(a, x, y, Model,alpha)                         
        w = w_m  * Omega_m + w_x  * Omega_x  # Total equation of state
        l = (k * c) / H0
        wxeff = w_xeff(a, h, x, y, etha, 1, model, alpha)
        #wmeff = w_meff(a, h, x, y, Omega_m, Omega_x, etha, 1, model)
        Qx0 = Q_x(a, h, x, y, Omega_m, Omega_x, Ux, Um, Dx, phi, k, etha, alpha, 0, model)
        Qm0 = -(Omega_x/Omega_m)*Qx0
        Qx1 = Q_x(a, h, x, y, Omega_m, Omega_x, Ux, Um, Dx, phi, k, etha, alpha, 1, model)
        Qm1 = -(Omega_x/Omega_m)*Qx1
        dQ_xda = dQxda(a, h, x, y, Omega_x, Omega_m, etha, alpha, model)
        dQ_mda = -(Omega_x/Omega_m)*dQ_xda
        dh_da = -(3/2) * (h/a) * (1 + w)
        domega_x_da = -(3/a) * (wxeff - w) * Omega_x 
        domega_m_da = -domega_x_da

        
        dy_da = -2* ( y)/a - U(x,1,Model,alpha)/h + ((Qx0*Omega_x*3*a*h)/y)
        dx_da = y / (a**2 * h)
        
        
        # Perturbations ODEs
        dphida = dphi(a, h, x, y, Omega_m, Omega_x, phi, Ux, Um, alpha, model)
        
        dumda = -(Um / a) - (phi/(a**2 * h)) -(Qm0/(a*h))*(Um - Ux)
        duxda = -(Ux / a) - (Csx / (1 + w_x)) * (Dx / (a**2 *h)) - (phi / (a**2 * h))
        
        dDmda = (9 / 2) * h * Omega_x * (1 + w_x) * (Um - Ux) + ((l**2 * Um) / (a**2 * h)) \
              + (3/a)*(Um - Ux)*(1 -(Qm0/3/h))*(a*Qm0) + (Qm1/(a*h)) + ((dQ_mda*Um)/(a*h)) -((Qm0*Dm)/(a*h))
                                                                                                                         
        dDxda = (3 * w_x * Dx)/a + (9 / 2) * h * Omega_m * (1 + w_x) * (Ux - Um) \
              + (1 + w_x) * ((l**2 * Ux) / (a**2 * h)) +(Qx1/(a*h)) \
              + ((dQ_xda*Ux)/(a*h))-(1+(Csx/(1+w_x)))*((Qx0*Dx)/(a*h))
        

        return np.array([dh_da, domega_m_da, domega_x_da, dy_da, dx_da,dphida,dDmda,dumda,dDxda,duxda])
    
    if model =="LCDM":
        return LCDM
    elif model  in ["RP ","SUGRA ","DEpx"]:
        return QCDM
    else:
        raise ValueError("Invalid models not CDM ")
