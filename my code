def solve_k(a, model, alpha, etha, A0, k_max=1, k_vals=10, method="LSODA", t_vals=None, atol=1e-8, rtol=1e-8,Filename = None):
    ks = np.linspace(1e-4, k_max, k_vals)
    results = []

    for k in ks:
        sol = solve_a(a, k, Model, alpha, A0, etha)
        results.append([k, *np.array(sol)[1:, -1]])
    solu1 = np.array(results)
    Filename = generate_matched_filenames(model, zs_list, etha_list, alpha_dict, A0, A1, A2)

    with h5py.File("solve_k.h5", "a") as f:
        f.create_dataset(Filename, data=solu1)

    return solu1.T
