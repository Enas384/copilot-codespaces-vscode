def transfer_function(k, Omega_m0):
    Omega_r = 9.24*1e-5
    a_eq = Omega_r /Omega_m0
    H_eq = (H0/c)*(np.sqrt((2*Omega_m0)/(a_eq)**3))
    k_eq = a_eq* H_eq
    s = k/k_eq
    T = ((np.log(1+ 0.171*s))/(0.171*s))*((1+ 0.284*s+(1.18*s)**2+(0.399*s)**3+(0.490*s)**4))**(-0.25)
    return T

def phi_decp(k, transfer_function):
    l = (k*c)/H0
    # Growth factor D1
    D1 = (5 / 2) * Omega_m0 * ((Omega_m0**(4 / 7) + (3 / 2) *Omega_m0 + (1 / 70) * Omega_x0 * (1 + (Omega_m0 / 2))))**-1
  
    # Initial conditions for perturbations
    As = -((5 * np.sqrt(2) * np.pi * DH) / 3)  # Normalization factor
    phi_p = As * (l)**((n - 1) / 2) * (Omega_m0 / D1)  # Primordial potential perturbation

    # Transfer function
    T = transfer_function(k, Omega_m0)

    # Evolving potential perturbations
    phi_decp = (9 / 10) * phi_p * T  # Dark matter dominated potential

    return phi_decp

def ICs( k, alpha, A0,etha, model):
         
    # Initial conditions function  
    def ICs_LCDM():   
        ICs_0 = np.array([h_0, Omega_m0, Omega_x0])  # initial conditions @a=1  
        l = (k * c) / H0  
        solu0 = solve_ivp(background, (a1[0], a1[-1]), ICs_0, t_eval=a1, args=(k,), rtol=1e-10, atol=1e-10)  
        # Backward integration from a=1e-3 to a=1  
        h_i, Omega_mi, Omega_xi = solu0.y[:, -1]  
        phi_d = phi_decp(k, transfer_function)  
        w_x = -1
        # Growth factor D1  
        D1 = (5 / 2) * Omega_m0 / ((Omega_m0**(4 / 7) + (3 / 2) * Omega_m0 + (1 / 70) * Omega_x0 * (1 + (Omega_m0 / 2)))) 
        phi_i = (D1 / a0) * phi_d  # Initial condition  

        R1 = -2 * (1 + w_m)  
        R2 = 3 * ((ai * h_i) / l)**2 * (1 + Omega_m0 * w_m + Omega_x0 * w_x)  
        Dm_i = (R1 / R2) * phi_d  
        Um_i = -(2 / (3 * ai * h_i * (1 + Omega_x0 * w_x))) * phi_d  
         
        return np.array([h_i, Omega_mi, Omega_xi, phi_i, Dm_i, Um_i]) 
    
    def ICs_QCDM():
        Omega_xi = 1e-8  # Omega_s + Omega_u
        Omega_mi = 1 - Omega_xi
        Omega_ui = Omega_xi / 2
        l = (k * c) / H0

        hi = np.sqrt(Omega_m0 /(ai**3 * Omega_mi))
        ui = 3 * hi**2 * Omega_ui
    
        xi = (A0 / (3 * hi**2 * Omega_ui))**(1 / alpha)

        yi = np.sqrt(2 * ai**2 *ui)
       
        w_x = w_xeff(ai, hi, xi, yi, etha, 1, Model)
        
       # print(w_x)
        w_m = w_meff(ai, hi, xi, yi, Omega_mi, Omega_xi, etha, 1, Model)
        
        phi_d = phi_decp(k, transfer_function)
        # Growth factor D1
        D1 = (5 / 2) * Omega_m0 * ((Omega_m0**(4 / 7) + (3 / 2) * Omega_m0 + (1 / 70) * Omega_x0 * (1 + (Omega_m0 / 2))))**-1
        phi_i = (D1 / a0) * phi_d     # Initial condition
    
        R1 = -2*(1 + w_m)
        R2 = 3 * ((ai*hi)/l)**2*(1 + Omega_m0 * w_m + Omega_x0 * w_x)
    
        Dm_i = (R1 / R2) * phi_d
        um_i = -(2 / (3*ai*hi*(1+Omega_x0*w_x))) * phi_d
        Dx_i = (Dm_i/(1+w_m)) * (1 + w_x)
        ux_i = um_i
        return np.array([hi, Omega_mi, Omega_xi, yi, xi,phi_i,Dm_i,um_i,Dx_i,ux_i])
    
    if model == "LCDM":
        return ICs_LCDM()
    elif model in "RP SUGRA DExp":
        return ICs_QCDM()
    else:
        raise ValueError("Invalid models not CDM ")

def solve_a(aStop,k, model,alpha, A0, etha,rtol=1e-8, method="LSODA",atol=1e-8,t_vals=None):
    ICs_values = ICs( k, alpha, A0, Model)
    od = ODEs( k, etha, alpha, Model)
    solu1 = solve_ivp(od, (ai, aStop), ICs_values, method=method, t_vals=t_vals, rtol=rtol, atol= atol) # 1e-10
    #return  solu1
    if model =="LCDM":
        h, Omega_m, Omega_x, phi, Dm, Um = solu1.y
        w_x = - np.ones(len(h))

        Ux = Dx = zeros(len(h))         # the same len as the h or  \omega_m
        a = solu1.t
        return  a, h, Omega_m, Omega_x, phi, Dm, Um, Dx, Ux, w_x
    
    elif model in "RP SUGRA DExp":
        h, Omega_m, Omega_x, y, x, phi, Dm, Um, Dx, Ux = solu1.y
        a = solu1.t
        w_x = w_q(a, x, y, Model, alpha)

        return a, h, Omega_m, Omega_x, phi, Dm, Um, Dx, Ux, w_x
    
def generate_matched_filenames(model, zs_list, etha_list, alpha_dict, A0,A1,A2):
    alpha_list = alpha_dict[model]
    if len(alpha_list) != len(etha_list):
        raise ValueError(f"alpha_list and etha_list must have the same length for {model}")

    filenames = []

    for zs in zs_list:
        for alpha, etha in zip(alpha_list, etha_list):
            if model == "LCDM":
                params = {}  # LCDM has no additional parameters
            elif model == "RP":
                params = {"A0": A0, "alpha": alpha}
            elif model == "SUGRA":
                params = {"A1": A1, "alpha1": alpha}
            elif model == "DEXP":
                params = {"A2": A2, "alpha2": alpha, "Gamma": 0.55, "beta": 2.5}
            else:
                raise ValueError(f"Unknown model: {model}")

            param = "_".join([f"{key}{value:.4f}" for key, value in params.items()]) if params else ""

            filename = f"results_zs{zs:.4f}_etha{etha:.4f}_A{A0:.4f}"
            if param:
                filename += f"_{param}"
            filename += f"_{model}"

            filenames.append(filename)

    return filenames

